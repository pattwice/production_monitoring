# Authentication Database
AUTH_DATABASE_URL= #example postgresql://auth_admin:auth_password_123@auth_db:5432/auth_db
AUTH_DB_USER= #auth_admin
AUTH_DB_PASSWORD= #auth_password_123
AUTH_DB_NAME= #auth_db


# Production Monitoring Database
PROD_DATABASE_URL= #example postgresql://prod_admin:prod_password_123@production_db:5432/production_monitoring
PROD_DB_USER= #prod_admin
PROD_DB_PASSWORD= #prod_password_123
PROD_DB_NAME= #production_monitoring

# Security
# Run "openssl rand -hex 32" in you terminal
SECRET_KEY= #paste_your_newly_generated_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME="Production Monitoring API"

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PgAdmin Credentials
PGADMIN_DEFAULT_EMAIL= #example admin@gmail.com
PGADMIN_DEFAULT_PASSWORD= #yourpassword123456